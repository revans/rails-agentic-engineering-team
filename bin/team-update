#!/usr/bin/env ruby
# bin/team-update
# Vendored into every installed target repo (same as bin/agent-log). Fetches
# the source repo's manifest.yml (bin/team-manifest's output) and compares
# it against this repo's own vendored agents/commands/skills/bin files and
# its team.lock.yml (the hash each file had as of the last successful sync)
# to tell "upstream changed this" apart from "this was hand-edited locally."
# See docs/updates.md for the full design and the /update agent
# (agents/updater.md) that drives this script.
#
# Usage:
#   bin/team-update plan  --dir /path/to/project [--source-repo URL]
#   bin/team-update apply --dir /path/to/project --snapshot-dir SNAP \
#     [--take-upstream path,path,...] [--keep-local path,path,...] [--remove path,path,...]
#   bin/team-update cleanup --snapshot-dir SNAP
#
# --dir defaults to the current directory. --source-repo overrides
# team.yml's optional `team.source_repo`, which overrides the hardcoded
# default below — same precedence order the installer scripts use for
# --repo vs. git-remote detection.
#
# Output contract: prints exactly one JSON object as the LAST line of
# stdout. `plan`'s status is "ok" or "failed"; on "ok" it also carries the
# categorized diff described in docs/updates.md. `apply` and `cleanup` are
# flat {status, detail} like bin/team-setup-project-status.

require "json"
require "yaml"
require "digest"
require "fileutils"
require "open3"
require "time"
require "tmpdir"
require "set"

DEFAULT_SOURCE_REPO = "https://github.com/revans/rails-agentic-engineering-team.git".freeze

def result(status, extra = {})
  puts JSON.generate({ status: status }.merge(extra))
end

def sh(*cmd, chdir: nil)
  opts = chdir ? { chdir: chdir } : {}
  out, _err, status = Open3.capture3(*cmd, **opts)
  [out.strip, status.success?]
end

def parse_flags(argv)
  flags = {}
  i = 0
  while i < argv.length
    if argv[i].start_with?("--")
      key = argv[i][2..]
      flags[key] = argv[i + 1]
      i += 2
    else
      i += 1
    end
  end
  flags
end

def csv(value)
  (value || "").split(",").map(&:strip).reject(&:empty?)
end

def sha256(path)
  return nil unless File.file?(path)

  Digest::SHA256.hexdigest(File.binread(path))
end

def team_source_repo(dir)
  path = File.join(dir, "team.yml")
  return nil unless File.exist?(path)

  cfg = YAML.load_file(path)
  cfg&.dig("team", "source_repo")
rescue StandardError
  nil
end

def resolve_source_repo(dir, cli_value)
  cli_value || team_source_repo(dir) || DEFAULT_SOURCE_REPO
end

# Returns {"files" => {}} when there's genuinely no lock yet — a fresh
# repo that's never synced, a legitimate case handled the same way
# throughout this script. A file that EXISTS but fails to parse, or
# doesn't come back as a hash, is a different situation and must not be
# folded into that same fallback: doing so would silently discard every
# file's sync history and make every real difference look like a
# no-history conflict, with no indication anything went wrong. Returns
# nil for that case instead, so callers can fail loudly.
def load_lock(dir)
  path = File.join(dir, "team.lock.yml")
  return { "files" => {} } unless File.exist?(path)

  lock = YAML.load_file(path)
  return nil unless lock.is_a?(Hash)

  lock["files"] = {} unless lock["files"].is_a?(Hash)
  lock
rescue StandardError
  nil
end

def load_lock!(dir)
  lock = load_lock(dir)
  if lock.nil?
    path = File.join(dir, "team.lock.yml")
    result("failed", detail: "#{path} exists but could not be parsed — check it for an accidental hand-edit, or remove it to force a fresh sync (this loses conflict history for every file)")
    exit 1
  end
  lock
end

LOCK_HEADER = <<~HEADER
  # team.lock.yml — generated by bin/team-update. Do not hand-edit.
  # Records the sha256 each vendored file had as of the last successful
  # sync from source_repo, so the next `/update` can tell an upstream
  # change apart from a local hand-edit. See docs/updates.md.
HEADER

def write_lock(dir, lock)
  File.write(File.join(dir, "team.lock.yml"), LOCK_HEADER + "\n" + lock.to_yaml)
end

CHANGELOG_HEADER = <<~HEADER
  # Updates Log

  Auto-generated by `bin/team-update` (via `/install`'s first vendor or `/update`). Newest entries first. Do not hand-edit — a sync only ever prepends a new entry, never rewrites an old one.
HEADER

# Prepends one entry recording what an apply actually changed. Skipped
# entirely when nothing did (a no-op sync shouldn't leave a paper trail).
def write_changelog(dir, version, vendored:, updated:, took_upstream:, kept_local:, removed:)
  return if [vendored, updated, took_upstream, kept_local, removed].all?(&:empty?)

  sections = {
    "Vendored" => vendored,
    "Updated from upstream" => updated,
    "Conflicts resolved — took upstream" => took_upstream,
    "Conflicts resolved — kept local (upstream change acknowledged, not applied)" => kept_local,
    "Removed (deleted upstream)" => removed,
  }

  entry = +"## #{Time.now.utc.iso8601} — synced to #{version}\n\n"
  sections.each do |title, paths|
    next if paths.empty?

    entry << "**#{title}:**\n\n"
    paths.sort.each { |p| entry << "- #{p}\n" }
    entry << "\n"
  end

  path = File.join(dir, "docs", "updates-log.md")
  FileUtils.mkdir_p(File.dirname(path))
  existing = File.exist?(path) ? File.read(path) : CHANGELOG_HEADER + "\n"
  # Insert the new entry right after the header block, ahead of every prior
  # entry — the header is everything before the first "## " line. partition
  # strips the matched "## " into its own return value, so it has to be
  # glued back onto `after` to reconstruct the untouched old entries.
  header, matched, after = existing.partition(/^## /)
  File.write(path, header + entry + "\n" + matched + after)
end

# Loads and validates manifest.yml's shape so a stale/hand-broken/wrong-repo
# manifest fails cleanly with the promised {"status":"failed"} JSON line
# instead of an uncaught NoMethodError — every caller of this script reads
# only the last stdout line and expects it to parse as JSON.
def load_manifest!(snapshot_dir)
  manifest_path = File.join(snapshot_dir, "manifest.yml")
  unless File.exist?(manifest_path)
    result("failed", detail: "#{snapshot_dir} has no manifest.yml — has /deploy been run in the source repo?")
    exit 1
  end

  manifest = YAML.load_file(manifest_path)
  unless manifest.is_a?(Hash) && manifest["files"].is_a?(Hash) && manifest["version"]
    result("failed", detail: "manifest.yml at #{manifest_path} is missing 'version' or 'files' — not a manifest bin/team-manifest produced")
    exit 1
  end

  manifest
end

def cmd_plan(flags)
  dir = File.expand_path(flags["dir"] || Dir.pwd)
  unless Dir.exist?(dir)
    result("failed", detail: "#{dir} does not exist")
    exit 1
  end

  source_repo = resolve_source_repo(dir, flags["source-repo"])
  snapshot_dir = Dir.mktmpdir("team-update-")
  FileUtils.remove_entry(snapshot_dir) # git clone needs the target to not exist
  _, clone_ok = sh("git", "clone", "--depth", "1", source_repo, snapshot_dir)
  unless clone_ok
    result("failed", detail: "git clone of #{source_repo} failed — check network access and the URL")
    exit 1
  end

  manifest = load_manifest!(snapshot_dir)
  lock = load_lock!(dir)
  lock_files = lock["files"] || {}

  new_files = []
  clean_updates = []
  conflicts = []
  local_only_edits = []
  unchanged_count = 0

  manifest["files"].each do |path, remote_sha|
    local_full = File.join(dir, path)
    local_sha = sha256(local_full)
    base_sha = lock_files[path]

    if local_sha.nil?
      new_files << path
    elsif local_sha == remote_sha
      # Content already matches — nothing would change on disk. True
      # regardless of whether a lock baseline exists yet; `apply` seeds one
      # silently for exactly this case, so it's never worth surfacing here.
      unchanged_count += 1
    elsif base_sha.nil?
      conflicts << { path: path, local_sha: local_sha, base_sha: nil, remote_sha: remote_sha }
    elsif local_sha == base_sha
      clean_updates << path
    elsif remote_sha == base_sha
      local_only_edits << path
    else
      conflicts << { path: path, local_sha: local_sha, base_sha: base_sha, remote_sha: remote_sha }
    end
  end

  removed_upstream = lock_files.keys - manifest["files"].keys

  result(
    "ok",
    snapshot_dir: snapshot_dir,
    manifest_version: manifest["version"],
    new_files: new_files.sort,
    clean_updates: clean_updates.sort,
    conflicts: conflicts.sort_by { |c| c[:path] },
    local_only_edits: local_only_edits.sort,
    removed_upstream: removed_upstream.sort,
    unchanged_count: unchanged_count,
  )
end

def cmd_apply(flags)
  dir = File.expand_path(flags["dir"] || Dir.pwd)
  snapshot_dir = flags["snapshot-dir"]
  unless snapshot_dir && Dir.exist?(snapshot_dir)
    result("failed", detail: "--snapshot-dir #{snapshot_dir.inspect} not found — re-run 'plan' first")
    exit 1
  end

  manifest = load_manifest!(snapshot_dir)
  lock = load_lock!(dir)
  lock["files"] ||= {}

  take_upstream = csv(flags["take-upstream"])
  keep_local = csv(flags["keep-local"])
  remove = csv(flags["remove"])

  # Classified from state as it was *before* this apply touches anything, so
  # the changelog entry below can tell "never had this file" from "had a
  # clean copy" from "had a diverged copy we're now overwriting" — the same
  # three-way distinction `plan` made, just re-derived here since `apply`
  # only receives flat path lists, not `plan`'s categorization.
  vendored = []
  updated = []
  conflicts_took_upstream = []

  take_upstream.each do |path|
    src = File.join(snapshot_dir, path)
    unless File.file?(src)
      result("failed", detail: "#{path} not found in snapshot — re-run 'plan' first")
      exit 1
    end
    dest = File.join(dir, path)
    old_local_sha = sha256(dest)
    old_base_sha = lock["files"][path]

    if old_local_sha.nil?
      vendored << path
    elsif old_local_sha == old_base_sha
      updated << path
    else
      conflicts_took_upstream << path
    end

    FileUtils.mkdir_p(File.dirname(dest))
    FileUtils.cp(src, dest)
    lock["files"][path] = manifest["files"][path]
  end

  keep_local.each do |path|
    lock["files"][path] = manifest["files"][path]
  end

  remove.each do |path|
    full = File.join(dir, path)
    File.delete(full) if File.exist?(full)
    lock["files"].delete(path)
  end

  touched = (take_upstream + keep_local + remove).to_set
  seeded = 0
  manifest["files"].each do |path, remote_sha|
    next if touched.include?(path)

    # A file that already matches upstream needs no user decision, but still
    # needs a lock baseline recorded — otherwise the next plan has no `base`
    # for it and any future edit on either side reads as an unexplained
    # conflict instead of a clean update. Safe to do unconditionally: it
    # only ever records a hash for content that's already in sync.
    if sha256(File.join(dir, path)) == remote_sha
      lock["files"][path] = remote_sha
      seeded += 1
    end
  end

  lock["source_repo"] = manifest["source_repo"]
  lock["synced_version"] = manifest["version"]
  lock["synced_at"] = Time.now.utc.iso8601
  write_lock(dir, lock)

  write_changelog(
    dir, manifest["version"],
    vendored: vendored, updated: updated, took_upstream: conflicts_took_upstream,
    kept_local: keep_local, removed: remove,
  )

  FileUtils.remove_entry(snapshot_dir)

  result(
    "ok",
    detail: "applied #{take_upstream.size}, acknowledged #{keep_local.size}, removed #{remove.size}, " \
            "seeded #{seeded} already-matching — synced to #{manifest["version"]}",
  )
end

def cmd_cleanup(flags)
  snapshot_dir = flags["snapshot-dir"]
  if snapshot_dir && Dir.exist?(snapshot_dir)
    FileUtils.remove_entry(snapshot_dir)
    result("ok", detail: "removed #{snapshot_dir}")
  else
    result("ok", detail: "nothing to remove")
  end
end

subcommand = ARGV[0]
flags = parse_flags(ARGV[1..] || [])

case subcommand
when "plan" then cmd_plan(flags)
when "apply" then cmd_apply(flags)
when "cleanup" then cmd_cleanup(flags)
else
  result("failed", detail: "unknown subcommand #{subcommand.inspect} — expected plan, apply, or cleanup")
  exit 1
end
