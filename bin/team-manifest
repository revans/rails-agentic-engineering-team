#!/usr/bin/env ruby
# bin/team-manifest
# Source-repo-only build tool: hashes every file this team vendors into an
# installed target repo (agents/, commands/, skills/, bin/ minus this script
# and commands/rails-deploy.md, both of which only make sense in this source repo)
# and writes manifest.yml at the repo root. bin/team-update, which IS
# vendored into target repos, reads that file to detect drift against this
# repo — see docs/updates.md for the full sync design.
#
# Usage:
#   bin/team-manifest [--dir /path/to/repo]
#
# --dir defaults to the current directory, same convention as
# bin/team-setup-project.
#
# Output contract: prints exactly one JSON object as the LAST line of
# stdout, matching bin/team-setup-project-status's flat shape (this is one
# operation, not a multi-step checklist):
#   {"status":"ok","detail":"manifest.yml written — 52 files, version 1.12.0"}
#   {"status":"failed","detail":"..."}

require "json"
require "yaml"
require "digest"
require "open3"
require "time"

TRACKED_GLOBS = %w[agents/**/* commands/**/* skills/**/* bin/*].freeze
EXCLUDED = %w[bin/team-manifest commands/rails-deploy.md].freeze

def parse_args(argv)
  args = { "dir" => Dir.pwd }
  i = 0
  while i < argv.length
    case argv[i]
    when "--dir" then args["dir"] = argv[i + 1]; i += 2
    else i += 1
    end
  end
  args
end

def sh(*cmd, chdir: nil)
  opts = chdir ? { chdir: chdir } : {}
  out, _err, status = Open3.capture3(*cmd, **opts)
  [out.strip, status.success?]
end

def result(status, detail)
  puts JSON.generate({ status: status, detail: detail })
end

args = parse_args(ARGV)
dir = File.expand_path(args["dir"])

unless Dir.exist?(dir)
  result("failed", "#{dir} does not exist")
  exit 1
end

version_path = File.join(dir, "VERSION")
unless File.exist?(version_path)
  result("failed", "VERSION not found at #{version_path}")
  exit 1
end
version = File.read(version_path).strip

source_repo, remote_ok = sh("git", "remote", "get-url", "origin", chdir: dir)
unless remote_ok && !source_repo.empty?
  result("failed", "could not resolve 'git remote get-url origin' in #{dir}")
  exit 1
end

files = {}
TRACKED_GLOBS.each do |glob|
  Dir.glob(File.join(dir, glob)).sort.each do |full|
    next unless File.file?(full)

    rel = full.delete_prefix("#{dir}/")
    next if EXCLUDED.include?(rel)

    files[rel] = Digest::SHA256.hexdigest(File.binread(full))
  end
end

if files.empty?
  result("failed", "no tracked files found under agents/, commands/, skills/, bin/ in #{dir}")
  exit 1
end

manifest = {
  "version" => version,
  "generated_at" => Time.now.utc.iso8601,
  "source_repo" => source_repo,
  "files" => files.sort.to_h,
}

header = <<~HEADER
  # manifest.yml — generated by bin/team-manifest. Do not hand-edit.
  # Records the sha256 of every vendored agent/skill/command/bin file so
  # bin/team-update in an installed repo can detect drift against this
  # source repo. See docs/updates.md.
HEADER

File.write(File.join(dir, "manifest.yml"), header + "\n" + manifest.to_yaml)

result("ok", "manifest.yml written — #{files.size} files, version #{version}")
