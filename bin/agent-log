#!/usr/bin/env ruby
# bin/agent-log
# Agent activity logging CLI for Rails agentic engineering team.
# Writes to db/agent_log.sqlite3 via the sqlite3 CLI (no gem required).
#
# Usage:
#   bin/agent-log run start  --agent-name engineer --feature-id F-001 --input-summary "..."
#   bin/agent-log run end    --run-id $RUN_ID --status completed --quality-score 8 --output-summary "..."
#   bin/agent-log decision   --run-id $RUN_ID --id eng-F001-001 --title "..." --rationale "..."
#   bin/agent-log event      --run-id $RUN_ID --type tool_call --description "..."
#   bin/agent-log query runs
#   bin/agent-log query decisions --run-id $RUN_ID
#   bin/agent-log query summary   --run-id $RUN_ID

require "securerandom"
require "open3"
require "json"
require "set"
require "fileutils"

# Resolved against the current working directory, not __dir__ — __dir__ follows
# symlinks to this script's real location, which would make every team's symlinked
# bin/agent-log collapse onto the same shared agentic-teams/db/agent_log.sqlite3
# regardless of which project actually invoked it. Every other artifact path in
# this ecosystem (docs/briefs, docs/design-concepts, docs/product-briefs) is
# already resolved relative to the invoking project's own root — the database
# needs to follow the same rule to stay one-file-per-consuming-project.
DB = ENV.fetch("AGENT_LOG_DB", File.join(Dir.pwd, "db/agent_log.sqlite3"))
FileUtils.mkdir_p(File.dirname(DB))

# Shared, version-tracked infrastructure: every team's own independent copy
# of this script is expected to be identical at a given SHARED_TOOL_VERSION.
# A mismatch between two copies in the same target project is exactly what
# /rails-update's conflict detection surfaces — when it fires on this file,
# compare this constant: taking whichever copy has the higher version is the
# right default resolution unless a specific reason says otherwise. Bump this,
# in every copy together, whenever this file's behavior changes.
#
# 1.2.0 — adds token/cost capture: runs.{tokens_in,tokens_out,cache_read_tokens,
#   cache_creation_tokens,model,usage_source}, the model_rates/billing_plans/billing_periods
#   tables, `usage sweep`, `billing setup|plan|rate|period(s)|rates`, and the dollar columns on
#   `query cost` plus `query billing`. No plan or rate is hardcoded — `billing setup` asks.
# 1.1.0 — adds runs.work_type and runs.related_feature_id (--type,
#   --related-feature), and carries two fixes that had been living only in a
#   downstream copy: the busy_timeout that stops concurrent writes vanishing,
#   and the named decision-id collision message.
SHARED_TOOL_VERSION = "1.2.0".freeze

# journal_mode is persisted in the database file's own header, so setting it
# once in SCHEMA (via migrate_once) is enough — every later connection reads
# WAL mode straight off the file. busy_timeout is NOT persisted; it is scoped
# to a single sqlite3 connection, and every command here spawns a brand-new
# sqlite3 process, so it must be re-applied on every single invocation via
# -cmd, not just once in SCHEMA. Without it, sqlite3's default 0ms busy
# timeout means a second writer arriving while another connection holds the
# write lock fails immediately with "database is locked" instead of waiting
# for it to clear — confirmed root cause of issue #214's writes vanishing
# under ~18 concurrent pipelines sharing this one file with no error anyone
# noticed. `-cmd ".timeout N"` (a dot-command, run before the main SQL) sets
# this cleanly; `PRAGMA busy_timeout=N` as the SQL itself would work too but
# echoes its new value as an extra output row, corrupting sq/sq_rows parsing.
BUSY_TIMEOUT_MS = (ENV["AGENT_LOG_BUSY_TIMEOUT_MS"] || 30_000).to_i
SQLITE = [ "sqlite3", "-cmd", ".timeout #{BUSY_TIMEOUT_MS}" ].freeze

SCHEMA = <<~SQL
  PRAGMA journal_mode=WAL;
  PRAGMA foreign_keys=ON;

  CREATE TABLE IF NOT EXISTS runs (
    id             TEXT PRIMARY KEY,
    agent_name     TEXT NOT NULL,
    feature_id     TEXT,
    work_type      TEXT,
    related_feature_id TEXT,
    input_mode     TEXT,
    input_summary  TEXT,
    status         TEXT NOT NULL DEFAULT 'running',
    quality_score  INTEGER,
    output_summary TEXT,
    started_at     TEXT NOT NULL,
    completed_at   TEXT,
    created_at     TEXT NOT NULL DEFAULT (datetime('now','localtime'))
  );

  CREATE TABLE IF NOT EXISTS decisions (
    id                      TEXT PRIMARY KEY,
    run_id                  TEXT NOT NULL REFERENCES runs(id),
    title                   TEXT NOT NULL,
    rationale               TEXT NOT NULL,
    alternatives_considered TEXT,
    decision_type           TEXT NOT NULL DEFAULT 'implementation',
    expected_outcome        TEXT,
    observed_outcome        TEXT,
    created_at              TEXT NOT NULL DEFAULT (datetime('now','localtime'))
  );

  CREATE TABLE IF NOT EXISTS events (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id       TEXT NOT NULL REFERENCES runs(id),
    event_type   TEXT NOT NULL,
    description  TEXT,
    duration_ms  INTEGER,
    started_at   TEXT,
    completed_at TEXT,
    created_at   TEXT NOT NULL DEFAULT (datetime('now','localtime'))
  );

  CREATE TABLE IF NOT EXISTS findings (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id       TEXT NOT NULL REFERENCES runs(id),
    category     TEXT NOT NULL,
    severity     TEXT NOT NULL DEFAULT 'NEEDS_WORK',
    file         TEXT,
    line         TEXT,
    description  TEXT,
    created_at   TEXT NOT NULL DEFAULT (datetime('now','localtime'))
  );

  -- A rate card, not a cost column. Rates change and a plan can be renegotiated, so the
  -- dollar figure is DERIVED at query time from the model and the period a run falls in,
  -- never frozen onto the run. effective_from lets an old run keep costing what it cost.
  CREATE TABLE IF NOT EXISTS model_rates (
    model               TEXT NOT NULL,
    effective_from      TEXT NOT NULL,
    input_per_mtok      REAL NOT NULL,
    output_per_mtok     REAL NOT NULL,
    cache_write_per_mtok REAL NOT NULL,
    cache_read_per_mtok REAL NOT NULL,
    source              TEXT,
    PRIMARY KEY (model, effective_from)
  );

  -- The RECURRING terms of whatever Claude plan this project is billed under. Separate from
  -- billing_periods because the plan is one stated fact and the periods are derived from it:
  -- a project on a different seat, or a different account entirely, records its own row here
  -- and gets correct per-feature costs with no change to this script. Nothing about any plan
  -- is hardcoded anywhere in this file — `billing setup` asks.
  CREATE TABLE IF NOT EXISTS billing_plans (
    id             TEXT PRIMARY KEY,
    plan_name      TEXT NOT NULL,
    seat_cost_usd  REAL NOT NULL,
    included_usd   REAL NOT NULL,
    cycle_day      INTEGER NOT NULL DEFAULT 1,
    effective_from TEXT NOT NULL,
    effective_to   TEXT,
    notes          TEXT,
    created_at     TEXT NOT NULL DEFAULT (datetime('now','localtime'))
  );

  -- What the seat actually costs and what it actually includes. included_usd is the token
  -- allowance; overage_usd is what was really billed on top, entered from an invoice rather
  -- than computed, because a computed overage is an estimate wearing an invoice's clothes.
  CREATE TABLE IF NOT EXISTS billing_periods (
    id             TEXT PRIMARY KEY,
    period_start   TEXT NOT NULL,
    period_end     TEXT NOT NULL,
    plan_name      TEXT,
    seat_cost_usd  REAL,
    included_usd   REAL,
    overage_usd    REAL,
    notes          TEXT,
    created_at     TEXT NOT NULL DEFAULT (datetime('now','localtime'))
  );

  CREATE TABLE IF NOT EXISTS reflections (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    run_id       TEXT NOT NULL REFERENCES runs(id),
    type         TEXT NOT NULL,
    description  TEXT NOT NULL,
    created_at   TEXT NOT NULL DEFAULT (datetime('now','localtime'))
  );

  CREATE INDEX IF NOT EXISTS idx_decisions_run      ON decisions(run_id);
  CREATE INDEX IF NOT EXISTS idx_events_run         ON events(run_id);
  CREATE INDEX IF NOT EXISTS idx_runs_feature       ON runs(feature_id);
  CREATE INDEX IF NOT EXISTS idx_runs_work_type     ON runs(work_type);
  CREATE INDEX IF NOT EXISTS idx_runs_related       ON runs(related_feature_id);
  CREATE INDEX IF NOT EXISTS idx_findings_run       ON findings(run_id);
  CREATE INDEX IF NOT EXISTS idx_findings_category  ON findings(category);
  CREATE INDEX IF NOT EXISTS idx_reflections_run    ON reflections(run_id);
  CREATE INDEX IF NOT EXISTS idx_reflections_type   ON reflections(type);
SQL

# Shared between the decision --id pre-check (the fast path for the common,
# non-racing case) and report_sqlite_failure!'s UNIQUE-constraint case (the
# backstop for two calls racing the identical fresh id — see that method's
# comment). Both need to hand the agent the exact same actionable message.
def decision_id_collision_message(id)
  prefix = id.sub(/\d+\z/, "")
  "Decision id #{id} already exists in #{DB} — decision ids are unique " \
  "across the whole shared database, not scoped per run. Find the next free " \
  "number with: bin/agent-log query decisions --run-id <a-prior-run-id-in-this-sequence>, " \
  "or directly: sqlite3 #{DB} \"SELECT id FROM decisions WHERE id LIKE '#{prefix}%' ORDER BY id\""
end

# A locked-database failure means the write genuinely never happened after
# waiting the full busy-timeout budget — distinct from every other sqlite3
# error (syntax, constraint, missing table), and worth calling out by name
# so whoever reads stderr knows to retry rather than treat it as a bug in
# the SQL itself.
#
# decision_id is passed only by the decision INSERT call. Two `decision --id`
# calls racing an identical fresh id can both pass the --id pre-check's
# SELECT before either INSERTs (check-then-act) — the PRIMARY KEY constraint
# still rejects the losing INSERT, so this is a second, always-correct
# backstop that gives the loser the same friendly message the pre-check
# gives the sequential case, instead of a raw sqlite3 error.
def report_sqlite_failure!(err, decision_id: nil)
  if err.include?("database is locked")
    $stderr.puts "sqlite3 error: database is locked — write did not happen after waiting " \
                 "#{BUSY_TIMEOUT_MS}ms for the shared #{DB} file to free up under concurrent " \
                 "load. Retry this command."
  elsif decision_id && err.include?("UNIQUE constraint failed: decisions.id")
    $stderr.puts "sqlite3 error: #{decision_id_collision_message(decision_id)}"
  else
    $stderr.puts "sqlite3 error: #{err.strip}"
  end
  exit 1
end

def sq(sql, *args, decision_id: nil)
  # Escape each argument for safe SQLite interpolation.
  bound = args.map { |a| a.nil? ? "NULL" : "'#{a.to_s.gsub("'", "''")}'" }
  i = 0
  interpolated = sql.gsub("?") { bound[i].tap { i += 1 } }
  migrate_once
  out, err, status = Open3.capture3(*SQLITE, DB, interpolated)
  report_sqlite_failure!(err, decision_id: decision_id) unless status.success?
  out.strip
end

def sq_rows(sql, *args)
  bound = args.map { |a| a.nil? ? "NULL" : "'#{a.to_s.gsub("'", "''")}'" }
  i = 0
  interpolated = sql.gsub("?") { bound[i].tap { i += 1 } }
  migrate_once
  # -separator for TSV output; -header for column names
  out, err, status = Open3.capture3(*SQLITE, "-separator", "\t", DB, interpolated)
  report_sqlite_failure!(err) unless status.success?
  out.strip.split("\n").map { |line| line.split("\t") }
end

def migrate_once
  return if @migrated
  @migrated = true
  system(*SQLITE, DB, SCHEMA, out: File::NULL, err: File::NULL)
  add_missing_run_columns!
end

# SCHEMA uses CREATE TABLE IF NOT EXISTS, so it never alters a table that already
# exists — a database created before a column was added would silently keep the old
# shape and every write of that column would fail. Add them explicitly instead.
# ALTER TABLE ADD COLUMN is non-destructive and the guard makes it idempotent.
def add_missing_run_columns!
  out, _err, status = Open3.capture3(*SQLITE, DB, "PRAGMA table_info(runs)")
  return unless status.success?
  existing = out.lines.map { |l| l.split("|")[1] }.compact
  # tokens_* and model are written by `usage`, not by `run end` — a subagent cannot see
  # its own token totals, so a flag on run end would record NULL for every honest agent.
  # cache_read_tokens is separate from tokens_in because it bills at a tenth of the input
  # rate and, measured, is ~96% of all tokens: folding them together overstates cost by
  # roughly two orders of magnitude.
  {
    "work_type" => "TEXT", "related_feature_id" => "TEXT",
    "tokens_in" => "INTEGER", "tokens_out" => "INTEGER",
    "cache_read_tokens" => "INTEGER", "cache_creation_tokens" => "INTEGER",
    "model" => "TEXT", "usage_source" => "TEXT"
  }.each do |col, type|
    next if existing.include?(col)
    system(*SQLITE, DB, "ALTER TABLE runs ADD COLUMN #{col} #{type}", out: File::NULL, err: File::NULL)
  end
end

# A transcript owns the run whose `run start` it executed. `run start` ends in `puts id`, so
# that id arrives as a tool result that is NOTHING BUT the UUID — which is what distinguishes
# it from the many other run ids a transcript may contain.
#
# Two weaker rules were measured and rejected. "Any known UUID near the word agent-log" gave
# 295 transcripts matching more than one run, because a parent's transcript quotes its
# children's ids. "First known UUID in file order" still gave 129 collisions, because the
# agent-log skill tells a resumed agent to run `query runs`, which prints dozens of other
# runs' ids before its own appears. Both would have attributed one agent's tokens to another
# and produced a confident, wrong cost per feature.
#
# The cost of the strict rule is coverage, not correctness: an agent that captures the id
# (RUN_ID=$(... run start ...)) never emits it, so its transcript cannot be matched at all.
# Those runs are left NULL rather than guessed, and `query cost` counts them in its NoData
# column so a partial total never reads as a complete one.
# The ownership rule, and the reason it is this strict. A run id is only believed when the WHOLE
# tool result is that id — optionally behind a shell assignment (`RUN_ID=<uuid>`, the shape the
# agent-log skill's own `run start` snippet produces) or a `Run ID:` label. Matching an id merely
# MENTIONED somewhere in a result is what produced the first sweep's mis-attribution: the skill
# tells a resumed agent to run `query runs`, which dumps every recent id into one result, so
# "contains a known id" made 295 transcripts claim runs that were not theirs.
# Measured before widening from bare-only to these three forms: 3.5x more runs matched, and still
# ZERO runs claimed by two different transcripts. That second number is the one that matters — a
# transcript legitimately holds many runs (an orchestrator spawns them), but a run belongs to
# exactly one transcript, so any nonzero count there means the rule is wrong.
BARE_UUID = /\A\s*(?:[A-Z_][A-Z0-9_]*=|Run\ ID:\s*)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\s*\z/i

def owning_run_id(node, known)
  case node
  when Hash
    c = node["content"]
    if c.is_a?(String) && (m = BARE_UUID.match(c)) && known.include?(m[1])
      return m[1]
    end
    node.each_value { |v| r = owning_run_id(v, known); return r if r }
  when Array
    node.each { |v| r = owning_run_id(v, known); return r if r }
  end
  nil
end

# Walks a parsed transcript line and sums every usage object it contains. Recursive because
# usage appears at several nesting depths and the shape is the harness's, not ours — a flat
# fetch would silently miss the nested ones and undercount.
def collect_usage(node, totals, &on_model)
  case node
  when Hash
    u = node["usage"]
    if u.is_a?(Hash)
      %w[input_tokens output_tokens cache_read_input_tokens cache_creation_input_tokens].each do |k|
        totals[k] += u[k] if u[k].is_a?(Integer)
      end
      on_model.call(node["model"]) if node["model"].is_a?(String) && on_model
    end
    node.each_value { |v| collect_usage(v, totals, &on_model) }
  when Array
    node.each { |v| collect_usage(v, totals, &on_model) }
  end
end

WORK_TYPES = %w[feature bugfix].freeze

# An agent that forgets --type should still produce a classified row rather than a
# NULL that quietly drops out of every grouped query. The canonical feature_id
# already encodes the answer, so derive it rather than trusting the caller to pass it.
def derive_work_type(explicit, feature_id)
  return explicit if explicit
  case feature_id
  when /\Abugfix-/ then "bugfix"
  when /\AF-/      then "feature"
  end
end

# Every flag this tool defines takes a value; none is a bare boolean. So a flag whose next
# token is missing, or is itself another flag, is always a mistake — and silently accepting it
# is the worst available outcome: `--run-id $RUN_ID --title "x"` with RUN_ID unset collapses to
# `--run-id --title "x"`, which used to store "--title" AS the run id and report success. Rows
# then landed under an id matching no run, invisible to every query, while the caller believed
# the write had worked (issue #509). Agents hit this routinely because each Bash invocation is
# a fresh shell, so a variable set in one call is empty in the next.
#
# A value that legitimately begins with "--" is still expressible as --flag=value; the bare-flag
# check below only fires on a single token that looks exactly like another flag, so a quoted
# phrase such as --description "-- see above" is untouched.
FLAG_SHAPED = /\A--[a-z][\w-]*\z/

def parse_args(argv)
  args = {}
  i = 0
  while i < argv.length
    unless argv[i].start_with?("--")
      i += 1
      next
    end

    flag = argv[i]

    if flag.include?("=")
      name, value = flag.sub(/^--/, "").split("=", 2)
      args[name.tr("-", "_").to_sym] = value
      i += 1
      next
    end

    value = argv[i + 1]
    if value.nil?
      fail!("#{flag} requires a value, but none was given. " \
            "If this came from a shell variable, it was unset — each Bash call is a fresh shell.")
    end
    if value.match?(FLAG_SHAPED)
      fail!("#{flag} requires a value, but was followed by #{value}, which is another flag. " \
            "If this came from a shell variable, it was unset — each Bash call is a fresh shell. " \
            "Use #{flag}=VALUE if the value genuinely starts with '--'.")
    end

    args[flag.sub(/^--/, "").tr("-", "_").to_sym] = value
    i += 2
  end
  args
end

def now_iso
  Time.now.strftime("%Y-%m-%dT%H:%M:%S")
end

def fail!(msg)
  $stderr.puts "ERROR: #{msg}"
  exit 1
end

# A run's dollar value at LIST rates. This is an attribution weight, not a bill: see
# the billing_periods comment in SCHEMA and `query billing`. Rates are looked up per run by
# model and by the run's own start date, so a rate change doesn't retroactively reprice
# finished work.
RATE_LOOKUP_SQL = <<~SQL.freeze
  SELECT r.id, r.feature_id, r.started_at,
         COALESCE(r.tokens_in,0), COALESCE(r.tokens_out,0),
         COALESCE(r.cache_creation_tokens,0), COALESCE(r.cache_read_tokens,0),
         r.model
  FROM runs r
  WHERE r.usage_source IS NOT NULL
SQL

def rate_card
  sq_rows("SELECT model, effective_from, input_per_mtok, output_per_mtok, cache_write_per_mtok, cache_read_per_mtok FROM model_rates ORDER BY model, effective_from")
    .group_by { |r| r[0] }
end

# The rate in force for this model on this date — the latest effective_from at or before it.
# A run whose model has no rate card entry contributes 0 and is counted separately, never
# silently priced at some other model's rate.
def rate_for(card, model, started_at)
  rows = card[model.to_s]
  return nil if rows.nil? || rows.empty?
  on = started_at.to_s[0, 10]
  match = rows.select { |r| r[1].to_s <= on }.last || rows.first
  { in: match[2].to_f, out: match[3].to_f, cw: match[4].to_f, cr: match[5].to_f }
end

def run_list_value(rate, t_in, t_out, cw, cr)
  return 0.0 if rate.nil?
  (t_in * rate[:in] + t_out * rate[:out] + cw * rate[:cw] + cr * rate[:cr]) / 1_000_000.0
end

def usd(n) = "$#{'%.2f' % n}"

require "date"

# Derive one billing_periods row per cycle from the plan, covering every month that actually
# holds a run. Regenerating is safe: rows are keyed by their own start/end, so a re-run after
# changing the seat price updates the same rows rather than doubling them. Any --overage
# already entered by hand is preserved — it came from an invoice and this cannot re-derive it.
def generate_periods_from_plan(plan_id)
  plan = sq_rows("SELECT plan_name, seat_cost_usd, included_usd, cycle_day, effective_from, COALESCE(effective_to,''), COALESCE(notes,'') FROM billing_plans WHERE id=?", plan_id).first
  return 0 if plan.nil?
  name, seat, included, cycle_day, eff_from, eff_to, notes = plan
  cycle_day = [ [ cycle_day.to_i, 1 ].max, 28 ].min

  bounds = sq_rows("SELECT MIN(date(started_at)), MAX(date(started_at)) FROM runs WHERE started_at IS NOT NULL").first
  return 0 if bounds.nil? || bounds[0].to_s.empty?
  first = [ Date.parse(bounds[0]), Date.parse(eff_from) ].max
  last  = Date.parse(bounds[1])
  last  = [ last, Date.parse(eff_to) ].min unless eff_to.to_s.empty?
  return 0 if first > last

  cursor = Date.new(first.year, first.month, cycle_day)
  cursor = cursor << 1 if cursor > first
  made = 0
  while cursor <= last
    nxt = (cursor >> 1)
    pe  = nxt - 1
    id  = "#{cursor}_#{pe}"
    existing_overage = sq_rows("SELECT overage_usd FROM billing_periods WHERE id=?", id).first&.first
    sq(
      "INSERT OR REPLACE INTO billing_periods (id, period_start, period_end, plan_name, seat_cost_usd, included_usd, overage_usd, notes) VALUES (?,?,?,?,?,?,?,?)",
      id, cursor.to_s, pe.to_s, name, seat, included, existing_overage, notes
    )
    made += 1
    cursor = nxt
  end
  made
end

def prompt(label, default = nil)
  $stderr.print default ? "#{label} [#{default}]: " : "#{label}: "
  $stderr.flush
  line = $stdin.gets
  return default if line.nil?
  line = line.strip
  line.empty? ? default : line
end

subcommand = ARGV.shift
# Only shift action for subcommands that have subactions (run, query).
# For leaf commands (decision, event, outcome, help) the next token is a flag.
action = if %w[run query usage billing].include?(subcommand) && ARGV.first && !ARGV.first.start_with?("--")
           ARGV.shift
end
args = parse_args(ARGV)

case subcommand

# ── run ──────────────────────────────────────────────────────────────────────

when "run"
  case action
  when "start"
    id = SecureRandom.uuid
    work_type = derive_work_type(args[:type], args[:feature_id])
    if args[:type] && !WORK_TYPES.include?(args[:type])
      fail!("--type must be one of #{WORK_TYPES.join(' | ')} (got #{args[:type].inspect})")
    end
    if args[:related_feature] && !args[:related_feature].match?(/\AF-\d{3}\z/)
      fail!("--related-feature must be an F-NNN feature id (got #{args[:related_feature].inspect}) — " \
            "it names the feature a bug belongs to, not the bug's own id")
    end
    sq(
      "INSERT INTO runs (id, agent_name, feature_id, work_type, related_feature_id, input_mode, input_summary, started_at) VALUES (?,?,?,?,?,?,?,?)",
      id, args[:agent_name] || "unknown", args[:feature_id], work_type, args[:related_feature],
      args[:input_mode] || "ad_hoc", args[:input_summary], now_iso
    )
    puts id

  when "end"
    fail!("--run-id required") unless args[:run_id]
    sq(
      "UPDATE runs SET status=?, quality_score=?, output_summary=?, completed_at=? WHERE id=?",
      args[:status] || "completed", args[:quality_score],
      args[:output_summary], now_iso, args[:run_id]
    )
    puts "Run #{args[:run_id]} closed."

  when "update"
    fail!("--run-id required") unless args[:run_id]
    unless args[:feature_id] || args[:status] || args[:type] || args[:related_feature]
      fail!("at least one of --feature-id, --status, --type or --related-feature required")
    end
    if args[:type] && !WORK_TYPES.include?(args[:type])
      fail!("--type must be one of #{WORK_TYPES.join(' | ')} (got #{args[:type].inspect})")
    end
    if args[:feature_id]
      sq("UPDATE runs SET feature_id=? WHERE id=?", args[:feature_id], args[:run_id])
      # Keep the classification consistent with the id it was just corrected to,
      # unless the caller is explicitly setting it in the same command.
      unless args[:type]
        derived = derive_work_type(nil, args[:feature_id])
        sq("UPDATE runs SET work_type=? WHERE id=?", derived, args[:run_id]) if derived
      end
    end
    sq("UPDATE runs SET work_type=? WHERE id=?", args[:type], args[:run_id]) if args[:type]
    sq("UPDATE runs SET related_feature_id=? WHERE id=?", args[:related_feature], args[:run_id]) if args[:related_feature]
    if args[:status]
      terminal = %w[completed failed abandoned].include?(args[:status])
      if terminal
        sq("UPDATE runs SET status=?, completed_at=COALESCE(completed_at, ?) WHERE id=?", args[:status], now_iso, args[:run_id])
      else
        sq("UPDATE runs SET status=? WHERE id=?", args[:status], args[:run_id])
      end
    end
    puts "Run #{args[:run_id]} updated."

  else
    fail!("Unknown run action: #{action}. Use: start, end, update")
  end

# ── decision ─────────────────────────────────────────────────────────────────

when "decision"
  fail!("--run-id required")   unless args[:run_id]
  fail!("--title required")    unless args[:title]
  fail!("--rationale required") unless args[:rationale]

  # Decision ids are unique across the WHOLE shared database, not scoped per
  # run — a round-2/resumed agent inherits an earlier round's {prefix}-NNN
  # sequence and has no way to know the next free number without querying
  # first. Checking up front (rather than letting the INSERT's UNIQUE
  # constraint fail and parsing sqlite3's error text) names the colliding id
  # and the fix directly, the same way run_exists?-style guards do elsewhere.
  # This is a fast path only — two calls racing the identical fresh id can
  # both pass this SELECT before either INSERTs; report_sqlite_failure!'s
  # decision_id: backstop (below) is what actually closes that race.
  if args[:id] && !sq_rows("SELECT id FROM decisions WHERE id=?", args[:id]).empty?
    fail!(decision_id_collision_message(args[:id]))
  end

  id = args[:id] || SecureRandom.uuid
  sq(
    "INSERT INTO decisions (id, run_id, title, rationale, alternatives_considered, decision_type, expected_outcome) VALUES (?,?,?,?,?,?,?)",
    id, args[:run_id], args[:title], args[:rationale],
    args[:alternatives], args[:type] || "implementation", args[:expected_outcome],
    decision_id: id
  )
  puts "Decision #{id} logged."

# ── event ────────────────────────────────────────────────────────────────────

when "event"
  fail!("--run-id required") unless args[:run_id]
  fail!("--type required")   unless args[:type]

  sq(
    "INSERT INTO events (run_id, event_type, description, duration_ms, started_at, completed_at) VALUES (?,?,?,?,?,?)",
    args[:run_id], args[:type], args[:description],
    args[:duration_ms], args[:started_at], args[:completed_at]
  )
  puts "Event logged."

# ── outcome ──────────────────────────────────────────────────────────────────

when "outcome"
  fail!("--id required")      unless args[:id]
  fail!("--observed required") unless args[:observed]
  sq("UPDATE decisions SET observed_outcome=? WHERE id=?", args[:observed], args[:id])
  puts "Outcome recorded for #{args[:id]}."

# ── finding ──────────────────────────────────────────────────────────────────

when "finding"
  fail!("--run-id required")   unless args[:run_id]
  fail!("--category required") unless args[:category]
  sq(
    "INSERT INTO findings (run_id, category, severity, file, line, description) VALUES (?,?,?,?,?,?)",
    args[:run_id], args[:category], args[:severity] || "NEEDS_WORK",
    args[:file], args[:line], args[:description]
  )
  puts "Finding [#{args[:category]}] logged."

# ── reflection ───────────────────────────────────────────────────────────────

when "reflection"
  fail!("--run-id required")      unless args[:run_id]
  fail!("--type required")        unless args[:type]
  fail!("--description required") unless args[:description]

  valid = %w[struggle assumption skill_gap input_quality]
  fail!("--type must be one of: #{valid.join(', ')}") unless valid.include?(args[:type])

  sq(
    "INSERT INTO reflections (run_id, type, description) VALUES (?,?,?)",
    args[:run_id], args[:type], args[:description]
  )
  puts "Reflection [#{args[:type]}] logged."

# ── query ────────────────────────────────────────────────────────────────────

when "usage"
  # Token usage is harness metadata: it exists in the subagent's transcript, not inside the
  # run. So it is reconciled from transcripts after the fact rather than self-reported at
  # `run end` — an agent asked for a number it cannot see reports nothing, and the column
  # would read NULL forever while looking implemented.
  #
  # The join is exact rather than heuristic: a transcript contains the `run start` output of
  # the run it belongs to, so the run UUID is literally in the file. Verified 12/12 when this
  # was built. Timestamp-matching an agent name would be a guess; this is not.
  case action
  when "sweep"
    dir = args[:dir] || File.join(Dir.home, ".claude", "jobs")
    abort "usage sweep: #{dir} does not exist" unless Dir.exist?(dir)

    known = sq_rows("SELECT id FROM runs").flatten.to_set
    updated = 0
    skipped = 0
    # Both shapes, because the two live in different trees and only one of them is obvious:
    # ~/.claude/projects holds session transcripts as .jsonl, ~/.claude/jobs holds background-job
    # output as .output. Globbing only one silently sweeps nothing and still exits 0.
    paths = Dir.glob(File.join(dir, "**", "*.jsonl")) + Dir.glob(File.join(dir, "**", "*.output"))
    abort "usage sweep: no .jsonl or .output files under #{dir}" if paths.empty?
    paths.each do |path|
      totals = Hash.new(0)
      model = nil
      run_id = nil
      File.foreach(path) do |line|
        line = line.strip
        next if line.empty?
        begin
          parsed = JSON.parse(line)
        rescue JSON::ParserError
          next
        end
        run_id ||= owning_run_id(parsed, known)
        collect_usage(parsed, totals) { |m| model ||= m }
      end

      if run_id.nil?
        skipped += 1
        next
      end
      next if totals.values.sum.zero?

      sq(<<~SQL)
        UPDATE runs SET
          tokens_in             = #{totals["input_tokens"].to_i},
          tokens_out            = #{totals["output_tokens"].to_i},
          cache_read_tokens     = #{totals["cache_read_input_tokens"].to_i},
          cache_creation_tokens = #{totals["cache_creation_input_tokens"].to_i},
          model                 = #{model ? "'" + model.gsub("'", "''") + "'" : "NULL"},
          usage_source          = 'transcript'
        WHERE id = '#{run_id}'
      SQL
      updated += 1
    end
    puts "usage sweep: #{updated} run(s) updated, #{skipped} transcript(s) with no matching run"
  else
    abort "usage: unknown action '#{action}' (expected: sweep)"
  end

when "billing"
  case action
  when "setup"
    unless $stdin.tty?
      fail!("billing setup is interactive. For a script, use: billing plan --name ... --seat-cost ... --included ... [--cycle-day N]")
    end
    $stderr.puts "Record the Claude plan this project is billed under."
    $stderr.puts "These figures are per-account, not per-project — take them from your billing page or an invoice.\n\n"
    name     = prompt("Seat / plan name (e.g. 'Claude Code premium seat')")
    fail!("a plan name is required") if name.to_s.empty?
    seat     = prompt("Seat cost per month, USD")
    included = prompt("Included token spend per month, USD (the allowance the seat buys)")
    cycle    = prompt("Day of month the billing cycle starts", "1")
    fail!("seat cost must be a number")       unless seat.to_s.match?(/\A\d+(\.\d+)?\z/)
    fail!("included amount must be a number") unless included.to_s.match?(/\A\d+(\.\d+)?\z/)
    confirmed = prompt("Are these figures confirmed against an invoice? (y/N)", "N")
    notes = confirmed.to_s.downcase.start_with?("y") ?
      "Confirmed against an invoice on #{Date.today}." :
      "STATED, NOT CONFIRMED (recorded #{Date.today}) — verify against an invoice before trusting any dollar figure derived from it."

    sq("UPDATE billing_plans SET effective_to = date('now','-1 day') WHERE effective_to IS NULL")
    id = SecureRandom.uuid
    sq("INSERT INTO billing_plans (id, plan_name, seat_cost_usd, included_usd, cycle_day, effective_from, notes) VALUES (?,?,?,?,?,?,?)",
       id, name, seat, included, cycle, (sq_rows("SELECT COALESCE(MIN(date(started_at)), date('now')) FROM runs").first&.first || Date.today.to_s), notes)
    made = generate_periods_from_plan(id)
    puts "Plan recorded. #{made} billing period(s) generated."
    puts "Next: bin/agent-log query billing"

  when "plan"
    %i[name seat_cost included].each { |f| fail!("--#{f.to_s.tr('_','-')} required") unless args[f] }
    sq("UPDATE billing_plans SET effective_to = date('now','-1 day') WHERE effective_to IS NULL")
    id = args[:id] || SecureRandom.uuid
    sq("INSERT OR REPLACE INTO billing_plans (id, plan_name, seat_cost_usd, included_usd, cycle_day, effective_from, notes) VALUES (?,?,?,?,?,?,?)",
       id, args[:name], args[:seat_cost], args[:included], (args[:cycle_day] || 1),
       args[:from] || (sq_rows("SELECT COALESCE(MIN(date(started_at)), date('now')) FROM runs").first&.first),
       args[:notes])
    made = generate_periods_from_plan(id)
    puts "Plan #{args[:name]} recorded. #{made} billing period(s) generated."

  when "rate"
    %i[model from].each { |f| fail!("--#{f} required") unless args[f] }
    %i[in out cache_write cache_read].each { |f| fail!("--#{f.to_s.tr('_','-')} required (USD per million tokens)") unless args[f] }
    sq(
      "INSERT OR REPLACE INTO model_rates (model, effective_from, input_per_mtok, output_per_mtok, cache_write_per_mtok, cache_read_per_mtok, source) VALUES (?,?,?,?,?,?,?)",
      args[:model], args[:from], args[:in], args[:out], args[:cache_write], args[:cache_read], args[:source]
    )
    puts "Rate recorded: #{args[:model]} from #{args[:from]} — in #{args[:in]}, out #{args[:out]}, cache-write #{args[:cache_write]}, cache-read #{args[:cache_read]} per Mtok."

  when "period"
    %i[start end].each { |f| fail!("--#{f} required (YYYY-MM-DD)") unless args[f] }
    id = args[:id] || "#{args[:start]}_#{args[:end]}"
    sq(
      "INSERT OR REPLACE INTO billing_periods (id, period_start, period_end, plan_name, seat_cost_usd, included_usd, overage_usd, notes) VALUES (?,?,?,?,?,?,?,?)",
      id, args[:start], args[:end], args[:plan], args[:seat_cost], args[:included], args[:overage], args[:notes]
    )
    puts "Billing period #{id} recorded."

  when "rates"
    rows = sq_rows("SELECT model, effective_from, input_per_mtok, output_per_mtok, cache_write_per_mtok, cache_read_per_mtok, COALESCE(source,'') FROM model_rates ORDER BY model, effective_from")
    if rows.empty?
      puts "(no rates recorded — bin/agent-log billing rate --model ... )"
    else
      puts "%-22s %-12s %8s %8s %11s %10s  %s" % %w[Model From In Out CacheWrite CacheRead Source]
      rows.each { |r| puts "%-22s %-12s %8s %8s %11s %10s  %s" % r.map(&:to_s) }
    end

  when "periods"
    rows = sq_rows("SELECT id, period_start, period_end, COALESCE(plan_name,''), COALESCE(seat_cost_usd,''), COALESCE(included_usd,''), COALESCE(overage_usd,''), COALESCE(notes,'') FROM billing_periods ORDER BY period_start")
    if rows.empty?
      puts "(no plan recorded — run: bin/agent-log billing setup)"
    else
      rows.each do |r|
        puts "#{r[0]}  #{r[1]}..#{r[2]}  #{r[3]}  seat=#{r[4]}  included=#{r[5]}  overage=#{r[6]}"
        puts "    #{r[7]}" unless r[7].to_s.empty?
      end
    end
  else
    abort "usage: billing [setup|plan|rate|period|rates|periods]"
  end

when "query"
  case action
  when "cost"
    # Two dollar columns, because under a subscription they are genuinely different numbers and
    # collapsing them would misstate the business. ListUSD is what these tokens would cost at
    # API list rates — an attribution WEIGHT, not a bill. BilledUSD is this feature's share of
    # what was actually paid (seat + overage) for the period its runs fall in, apportioned by
    # that weight. Within the included allowance the marginal cost of a token is zero, so
    # tokens x list rate is the wrong arithmetic for "what did this feature cost me" and the
    # right arithmetic for "how much of the seat did this feature consume".
    card    = rate_card
    periods = sq_rows("SELECT period_start, period_end, COALESCE(seat_cost_usd,0), COALESCE(overage_usd,0) FROM billing_periods ORDER BY period_start")
    runs    = sq_rows(RATE_LOOKUP_SQL)

    if runs.empty?
      puts "(no usage recorded yet — run: bin/agent-log usage sweep)"
    else
      unpriced = Hash.new(0)
      by_feature = Hash.new { |h, k| h[k] = { runs: 0, ti: 0, to: 0, cw: 0, cr: 0, list: 0.0, billed: 0.0 } }
      period_list = Hash.new(0.0)
      per_run = []

      runs.each do |id, feature, started, ti, to, cw, cr, model|
        rate = rate_for(card, model, started)
        unpriced[model.to_s] += 1 if rate.nil?
        value = run_list_value(rate, ti.to_i, to.to_i, cw.to_i, cr.to_i)
        on = started.to_s[0, 10]
        pkey = periods.find { |ps, pe, _, _| ps <= on && on <= pe }&.first
        period_list[pkey] += value if pkey
        per_run << [ feature, value, pkey ]

        f = by_feature[feature.to_s.empty? ? "(none)" : feature]
        f[:runs] += 1; f[:ti] += ti.to_i; f[:to] += to.to_i
        f[:cw] += cw.to_i; f[:cr] += cr.to_i; f[:list] += value
      end

      # Apportion each period's real outlay across the runs that fall inside it, by list value.
      paid = periods.to_h { |ps, _, seat, over| [ ps, seat.to_f + over.to_f ] }
      per_run.each do |feature, value, pkey|
        next if pkey.nil? || period_list[pkey].zero?
        key = feature.to_s.empty? ? "(none)" : feature
        by_feature[key][:billed] += paid[pkey].to_f * (value / period_list[pkey])
      end

      nodata = sq_rows("SELECT COALESCE(feature_id,'(none)'), COUNT(*) FROM runs WHERE usage_source IS NULL GROUP BY 1").to_h

      puts "%-10s %5s %14s %16s %11s %11s %7s" % [ "Feature", "Runs", "CacheWrite", "CacheRead", "ListUSD", "BilledUSD", "NoData" ]
      puts "-" * 82
      by_feature.sort_by { |_, v| -v[:list] }.first(30).each do |feature, v|
        puts "%-10s %5d %14d %16d %11s %11s %7s" % [
          feature, v[:runs], v[:cw], v[:cr], usd(v[:list]),
          v[:billed].zero? ? "-" : usd(v[:billed]), nodata[feature].to_s
        ]
      end
      puts "-" * 82
      # Printed against the FULL set, not the 30 rows above — the shown rows are a truncation and
      # a total computed from them would silently understate every figure.
      puts "%-10s %5d %14d %16d %11s %11s %7s" % [
        "ALL (#{by_feature.size})", by_feature.values.sum { |v| v[:runs] },
        by_feature.values.sum { |v| v[:cw] }, by_feature.values.sum { |v| v[:cr] },
        usd(by_feature.values.sum { |v| v[:list] }), usd(by_feature.values.sum { |v| v[:billed] }),
        nodata.values.sum { |n| n.to_i }.to_s
      ]
      puts "\nListUSD   = list-rate value of the tokens. An attribution weight, not an invoice."
      puts "BilledUSD = share of (seat + overage) actually paid for the enclosing period. '-' means"
      puts "            the run falls outside every recorded billing period."
      puts "NoData    = runs in that feature with no usage reconciled (transcript gone or never swept)."
      unless unpriced.empty?
        puts "\nNOT PRICED (no model_rates row, counted as $0): " +
             unpriced.map { |m, n| "#{m.empty? ? '(no model)' : m} x#{n}" }.join(", ")
      end
    end

  when "billing"
    card    = rate_card
    periods = sq_rows("SELECT id, period_start, period_end, COALESCE(plan_name,''), COALESCE(seat_cost_usd,0), COALESCE(included_usd,0), COALESCE(overage_usd,0) FROM billing_periods ORDER BY period_start")
    if periods.empty?
      puts "(no plan recorded — run: bin/agent-log billing setup)"
    else
      runs = sq_rows(RATE_LOOKUP_SQL)
      periods.each do |id, ps, pe, plan, seat, included, over|
        value = runs.sum { |_, _, started, ti, to, cw, cr, model|
          on = started.to_s[0, 10]
          next 0.0 unless on >= ps && on <= pe
          run_list_value(rate_for(card, model, started), ti.to_i, to.to_i, cw.to_i, cr.to_i)
        }
        paid = seat.to_f + over.to_f
        pct  = included.to_f.zero? ? nil : (value / included.to_f * 100)
        # A period with runs but no reconciled usage is NOT a period of zero spend — it is a
        # period we cannot see. Printing "$0.00 — 0% of allowance" for it would read as an
        # measured underspend and silently understate what the seat actually bought.
        total_runs, measured = sq_rows(
          "SELECT COUNT(*), SUM(CASE WHEN usage_source IS NOT NULL THEN 1 ELSE 0 END) FROM runs WHERE date(started_at) BETWEEN ? AND ?", ps, pe
        ).first.map(&:to_i)
        puts "#{id}  #{ps}..#{pe}  #{plan}"
        if measured.zero?
          puts "  NO USAGE DATA — #{total_runs} run(s) in this period, none with token counts"
          puts "  paid                  #{usd(paid)} (seat #{usd(seat)} + overage #{usd(over)})"
          next
        end
        puts "  coverage              #{measured}/#{total_runs} runs measured (#{(measured * 100.0 / total_runs).round}%)" if total_runs > 0
        puts "  consumed (list value) #{usd(value)}#{pct ? format(' — %.0f%% of the %s included', pct, usd(included)) : ''}"
        puts "                        measured runs only; the true figure is higher" if measured < total_runs
        puts "  paid                  #{usd(paid)} (seat #{usd(seat)} + overage #{usd(over)})"
        if value > 0 && paid > 0
          puts "  effective discount    %.1fx versus list" % (value / paid)
        end
        if pct && pct > 100
          puts "  OVER ALLOWANCE by #{usd(value - included.to_f)} of list value — if overage is billed at list,"
          puts "  that is the figure to reconcile against the invoice; --overage records what was really charged."
        end
      end
    end

  when "runs"
    rows = sq_rows(
      "SELECT id, agent_name, feature_id, status, quality_score, started_at, substr(input_summary,1,50) FROM runs ORDER BY started_at DESC LIMIT 20"
    )
    if rows.empty?
      puts "(no runs recorded)"
    else
      puts "%-36s  %-10s  %-8s  %-9s  %s  %s  %s" % %w[ID Agent Feature Status Score Started Summary]
      puts "-" * 110
      rows.each do |r|
        puts "%-36s  %-10s  %-8s  %-9s  %-5s  %s  %s" % r.map { |v| v.to_s }
      end
    end

  when "decisions"
    fail!("--run-id required") unless args[:run_id]
    rows = sq_rows(
      "SELECT id, decision_type, title, created_at FROM decisions WHERE run_id=? ORDER BY created_at",
      args[:run_id]
    )
    rows.empty? ? puts("(no decisions for this run)") : rows.each { |r| puts "[#{r[1]}] #{r[0]} — #{r[2]} (#{r[3]})" }

  when "events"
    fail!("--run-id required") unless args[:run_id]
    rows = sq_rows(
      "SELECT event_type, description, duration_ms, created_at FROM events WHERE run_id=? ORDER BY created_at",
      args[:run_id]
    )
    rows.empty? ? puts("(no events for this run)") : rows.each { |r|
      ms = r[2].to_s.empty? ? "" : " [#{r[2]}ms]"
      puts "[#{r[0]}]#{ms} #{r[1]} (#{r[3]})"
    }

  when "findings"
    fail!("--run-id required") unless args[:run_id]
    rows = sq_rows(
      "SELECT category, severity, file, line, description, created_at FROM findings WHERE run_id=? ORDER BY category, created_at",
      args[:run_id]
    )
    rows.empty? ? puts("(no findings for this run)") : rows.each { |r|
      loc = [ r[2], r[3] ].compact.reject(&:empty?).join(":")
      puts "[#{r[1]}][#{r[0]}]#{loc.empty? ? "" : " #{loc}"} — #{r[4]} (#{r[5]})"
    }

  when "reflections"
    fail!("--run-id required") unless args[:run_id]
    rows = sq_rows(
      "SELECT type, description, created_at FROM reflections WHERE run_id=? ORDER BY type, created_at",
      args[:run_id]
    )
    rows.empty? ? puts("(no reflections for this run)") : rows.each { |r|
      puts "[#{r[0]}] #{r[1]} (#{r[2]})"
    }

  when "skill-gaps"
    rows = sq_rows(
      "SELECT r.description, COUNT(*) as times, GROUP_CONCAT(DISTINCT ru.agent_name) as agents, GROUP_CONCAT(DISTINCT ru.feature_id) as features
       FROM reflections r JOIN runs ru ON r.run_id = ru.id
       WHERE r.type = 'skill_gap'
       GROUP BY r.description ORDER BY times DESC"
    )
    rows.empty? ? puts("(no skill gaps recorded)") : rows.each { |r|
      puts "[#{r[1]}x] #{r[0]}\n  agents: #{r[2]}  features: #{r[3]}\n"
    }

  when "struggles"
    rows = sq_rows(
      "SELECT r.description, COUNT(*) as times, GROUP_CONCAT(DISTINCT ru.agent_name) as agents
       FROM reflections r JOIN runs ru ON r.run_id = ru.id
       WHERE r.type = 'struggle'
       GROUP BY r.description ORDER BY times DESC"
    )
    rows.empty? ? puts("(no struggles recorded)") : rows.each { |r|
      puts "[#{r[1]}x] #{r[0]} (agents: #{r[2]})"
    }

  when "assumptions"
    rows = sq_rows(
      "SELECT ru.agent_name, r.description, COUNT(*) as times
       FROM reflections r JOIN runs ru ON r.run_id = ru.id
       WHERE r.type = 'assumption'
       GROUP BY ru.agent_name, r.description ORDER BY ru.agent_name, times DESC"
    )
    rows.empty? ? puts("(no assumptions recorded)") : rows.each { |r|
      puts "[#{r[0]}] #{r[1]} (#{r[2]}x)"
    }

  when "input-quality"
    # Ratings are logged unconditionally, every run — unlike struggles/assumptions,
    # each description is a one-off ("Rating: N/10 — ...") rather than a recurring
    # phrase, so this orders chronologically per agent instead of grouping by count.
    # That ordering is the point: read top to bottom within one agent_name to see
    # whether the rating it gives its upstream artifact is trending up or down.
    rows = sq_rows(
      "SELECT ru.agent_name, ru.feature_id, r.description, r.created_at
       FROM reflections r JOIN runs ru ON r.run_id = ru.id
       WHERE r.type = 'input_quality'
       ORDER BY ru.agent_name, r.created_at"
    )
    rows.empty? ? puts("(no input-quality reflections recorded)") : rows.each { |r|
      puts "[#{r[0]}][#{r[1]}] #{r[2]} (#{r[3]})"
    }

  when "summary"
    fail!("--run-id required") unless args[:run_id]
    run = sq_rows("SELECT * FROM runs WHERE id=?", args[:run_id]).first
    fail!("Run not found") unless run
    d_count = sq("SELECT COUNT(*) FROM decisions WHERE run_id=?", args[:run_id])
    e_count = sq("SELECT COUNT(*) FROM events    WHERE run_id=?", args[:run_id])
    puts "Run ID:     #{run[0]}"
    puts "Agent:      #{run[1]}  mode=#{run[3]}"
    puts "Feature:    #{run[2].to_s.empty? ? "(ad-hoc)" : run[2]}"
    puts "Status:     #{run[5]}  quality=#{run[6]}"
    puts "Started:    #{run[8]}"
    puts "Completed:  #{run[9].to_s.empty? ? "(in progress)" : run[9]}"
    puts "Decisions:  #{d_count}"
    puts "Events:     #{e_count}"
    puts "Summary:    #{run[7]}"

  when "stale"
    # Running rows past a plausible session length — nothing external ever closes
    # a run on an agent's behalf (see docs/agent-analysis/2026-09-10-stale-run-status.md),
    # so these accumulate silently unless something surfaces them on demand.
    hours = (args[:hours] || 4).to_i
    cutoff = (Time.now - hours * 3600).strftime("%Y-%m-%dT%H:%M:%S")
    rows = sq_rows(
      "SELECT id, agent_name, feature_id, started_at, substr(input_summary,1,50)
       FROM runs WHERE status='running' AND started_at < ? ORDER BY started_at",
      cutoff
    )
    if rows.empty?
      puts "(no stale runs — none running longer than #{hours}h)"
    else
      puts "%-36s  %-14s  %-8s  %s  %s" % %w[ID Agent Feature Started Summary]
      puts "-" * 110
      rows.each { |r| puts "%-36s  %-14s  %-8s  %s  %s" % r.map { |v| v.to_s } }
    end

  else
    fail!("Unknown query: #{action}. Use: runs, decisions, events, findings, reflections, skill-gaps, struggles, assumptions, input-quality, stale, summary")
  end

# ── help / default ────────────────────────────────────────────────────────────

when "check"
  ok = true
  [ [ "ruby", "ruby --version" ], [ "sqlite3", "sqlite3 --version" ] ].each do |name, cmd|
    if system(cmd, out: File::NULL, err: File::NULL)
      puts "#{name}: OK"
    else
      puts "#{name}: NOT FOUND"
      ok = false
    end
  end
  if ok
    puts "Environment ready. Database: #{DB}"
  else
    $stderr.puts "Missing dependencies. Install ruby and sqlite3 before using bin/agent-log."
    exit 1
  end

when "help", nil
  puts <<~HELP
    bin/agent-log — agent activity logging

    Run lifecycle:
      run start  --agent-name NAME [--feature-id F-001|bugfix-249] [--type feature|bugfix]
                 [--related-feature F-030] [--input-mode ad_hoc|structured_feature]
                 [--input-summary "..."]
                   → prints RUN_ID

                 --feature-id is this work's own canonical id: F-NNN for a feature,
                 bugfix-N for a bug fix. Never a bare number — a 2026-09-29 audit found
                 501 runs mislabelled that way, with bug fixes landing in the F- namespace
                 and silently contaminating every feature-level query.

                 --type is derived from --feature-id when omitted, so it is a safety net
                 rather than a chore. Pass it explicitly when the id is unknown.

                 --related-feature names the FEATURE a bug belongs to (F-030), not the
                 bug's own id — it is what makes "which feature generates the most bugs"
                 answerable. Meaningless on a feature run; set it on bugfix runs.

      run end    --run-id ID [--status completed|failed|abandoned]
                 [--quality-score 1-10] [--output-summary "..."]

      run update --run-id ID [--feature-id F-001] [--status running|completed|failed|abandoned]
                 [--type feature|bugfix] [--related-feature F-030]
                 Corrects a run's feature-id, type, related feature or status without going
                 through run end — for backfilling any of them once resolved, or closing out
                 a stale run found via `query stale`.

    Logging:
      decision   --run-id ID --title "..." --rationale "..."
                 [--id eng-F001-001] [--alternatives "..."]
                 [--type implementation|deviation|dependency|gap]
                 [--expected-outcome "..."]

      outcome    --id eng-F001-001 --observed "what actually happened"

      event      --run-id ID --type tool_call|file_read|file_write|bash|test_run
                 --description "..." [--duration-ms N]

      finding    --run-id ID --category CATEGORY
                 [--severity NEEDS_WORK|PASS_WITH_NOTES]
                 [--file path/to/file.rb] [--line 42]
                 --description "specific issue"

      reflection --run-id ID --type struggle|assumption|skill_gap|input_quality
                 --description "..."

    Queries:
      query runs
      query decisions      --run-id ID
      query events         --run-id ID
      query findings       --run-id ID
      query reflections    --run-id ID
      query skill-gaps                    # cross-run aggregate
      query struggles                     # cross-run aggregate
      query assumptions                   # cross-run aggregate
      query input-quality                 # cross-run aggregate, chronological per agent
      query stale           [--hours N]   # running rows older than N hours (default 4)
      query summary        --run-id ID

    Environment:
      check      Verify ruby and sqlite3 are on PATH

    Database: #{DB}
    Override: AGENT_LOG_DB=/path/to/other.sqlite3 bin/agent-log ...
  HELP

else
  fail!("Unknown command: #{subcommand}. Run `bin/agent-log help`.")
end
